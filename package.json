{
  "name": "8978-ai-platform-control-plane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:worker",
    "test:node": "node --test test/*.test.js",
    "test:worker": "vitest run",
    "check": "node scripts/validate-artifacts.js",
    "secret-scan": "node scripts/secret-scan.js",
    "cf:types": "wrangler types",
