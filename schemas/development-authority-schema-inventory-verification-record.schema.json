{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8978.ai/schemas/development-authority-schema-inventory-verification-record.schema.json",
  "title": "Development Authority Schema Inventory Verification Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "governing", "environment", "source", "authorization", "operator", "prerequisite", "execution", "evidence", "observations", "independentReview", "conclusions", "externalEffects", "failurePolicy", "errors", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["VERIFIED", "STOPPED_NO_QUERY", "INCONCLUSIVE_READ_ONLY"] },
    "governing": { "const": false },
    "environment": { "const": "development" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewedCommit", "packetPath", "packetSha256", "authorizedAccountId"],
      "properties": {
        "reviewedCommit": { "const": "fb0812cf84508602904dc556ebde5f1f6c88c7a3" },
        "packetPath": { "const": "deployment/development-authority-schema-inventory-verification-packet.json" },
        "packetSha256": { "const": "0d4db909103fffbc81b70d09335dcf44f84261fd8593234b242f035cde49c0c8" },
        "authorizedAccountId": { "const": "de5e0273347b0b4c5f8f4e554aa2288f" }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["ownerDecisionId", "ownerAuthorizationDigest", "accountId", "readOnlyVerificationAuthorized", "authorizedAttemptLimit"],
      "properties": {
        "ownerDecisionId": { "type": ["string", "null"], "minLength": 1 },
        "ownerAuthorizationDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "accountId": { "type": ["string", "null"] },
        "readOnlyVerificationAuthorized": { "type": "boolean" },
        "authorizedAttemptLimit": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["principalId", "authenticatedAccountId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "authenticatedAccountId": { "type": ["string", "null"] }
      }
    },
    "prerequisite": {
      "type": "object", "additionalProperties": false,
      "required": ["executionRecordPath", "executionRecordSha256", "status", "independentlyAccepted"],
      "properties": {
        "executionRecordPath": { "const": "deployment/development-authority-migration-execution-record.json" },
        "executionRecordSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["COMPLETED", null] },
        "independentlyAccepted": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["attemptCount", "invoked", "commandsInvoked", "outcome"],
      "properties": {
        "attemptCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "invoked": { "type": "boolean" },
        "commandsInvoked": { "type": "array", "maxItems": 6, "items": { "enum": ["databaseInfo", "definitions", "appliedMigrations", "foreignKeys", "integrity", "authorityRows"] } },
        "outcome": { "enum": ["NOT_INVOKED", "SUCCEEDED", "FAILED", "INTERRUPTED", "AMBIGUOUS"] }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["queryResultSha256"],
      "properties": { "queryResultSha256": {
        "type": "object", "additionalProperties": false,
        "required": ["databaseInfo", "definitions", "appliedMigrations", "foreignKeys", "integrity", "authorityRows"],
        "properties": {
          "databaseInfo": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "definitions": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "appliedMigrations": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "foreignKeys": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "integrity": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "authorityRows": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      } }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["database", "definitions", "migrations", "foreignKey", "integrity", "authorityData"],
      "properties": {
        "database": { "type": "object", "additionalProperties": false, "required": ["retrieved", "name", "databaseId", "region", "jurisdiction", "version", "identityMatched"], "properties": {
          "retrieved": { "type": "boolean" }, "name": { "type": ["string", "null"] }, "databaseId": { "type": ["string", "null"] }, "region": { "type": ["string", "null"] }, "jurisdiction": { "type": ["string", "null"] }, "version": { "type": ["string", "null"] }, "identityMatched": { "type": "boolean" }
        } },
        "definitions": { "type": "object", "additionalProperties": false, "required": ["retrieved", "tables", "indexes", "definitionsSha256"], "properties": {
          "retrieved": { "type": "boolean" }, "tables": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } }, "indexes": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } }, "definitionsSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        } },
        "migrations": { "type": "object", "additionalProperties": false, "required": ["retrieved", "names"], "properties": {
          "retrieved": { "type": "boolean" }, "names": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } }
        } },
        "foreignKey": { "type": "object", "additionalProperties": false, "required": ["retrieved", "fromTable", "toTable", "fromColumn", "toColumn", "onUpdate", "onDelete", "matched"], "properties": {
          "retrieved": { "type": "boolean" }, "fromTable": { "type": ["string", "null"] }, "toTable": { "type": ["string", "null"] }, "fromColumn": { "type": ["string", "null"] }, "toColumn": { "type": ["string", "null"] }, "onUpdate": { "type": ["string", "null"] }, "onDelete": { "type": ["string", "null"] }, "matched": { "type": "boolean" }
        } },
        "integrity": { "type": "object", "additionalProperties": false, "required": ["retrieved", "result"], "properties": { "retrieved": { "type": "boolean" }, "result": { "type": ["string", "null"] } } },
        "authorityData": { "type": "object", "additionalProperties": false, "required": ["retrieved", "rowCount"], "properties": { "retrieved": { "type": "boolean" }, "rowCount": { "type": ["integer", "null"], "minimum": 0 } } }
      }
    },
    "independentReview": {
      "type": "object", "additionalProperties": false,
      "required": ["completed", "checkerPrincipalId", "checkerDigest", "accepted"],
      "properties": {
        "completed": { "type": "boolean" }, "checkerPrincipalId": { "type": ["string", "null"], "minLength": 1 }, "checkerDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }, "accepted": { "type": "boolean" }
      }
    },
    "conclusions": {
      "type": "object", "additionalProperties": false,
      "required": ["inventoryVerified", "definitionsVerified", "foreignKeysVerified", "integrityVerified", "emptyAuthorityDataVerified", "remoteSchemaVerified", "activationPlanUpdateAuthorized", "activationPlanUpdated"],
      "properties": {
        "inventoryVerified": { "type": "boolean" }, "definitionsVerified": { "type": "boolean" }, "foreignKeysVerified": { "type": "boolean" }, "integrityVerified": { "type": "boolean" }, "emptyAuthorityDataVerified": { "type": "boolean" }, "remoteSchemaVerified": { "type": "boolean" }, "activationPlanUpdateAuthorized": { "const": false }, "activationPlanUpdated": { "const": false }
      }
    },
    "externalEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["mutatingSqlExecuted", "migrationAppliedOrCreated", "runtimeBindingInstalled", "workerCreatedOrDeployed", "workflowCreatedOrTriggered", "queueConnectedOrPublished", "secretOrKeyChanged", "authorityDataWritten", "projectKnowledgeSeeded", "activationEvidenceWritten", "deploymentActivated", "productionOrCustomerResourceTouched"],
      "properties": {
        "mutatingSqlExecuted": { "const": false }, "migrationAppliedOrCreated": { "const": false }, "runtimeBindingInstalled": { "const": false }, "workerCreatedOrDeployed": { "const": false }, "workflowCreatedOrTriggered": { "const": false }, "queueConnectedOrPublished": { "const": false }, "secretOrKeyChanged": { "const": false }, "authorityDataWritten": { "const": false }, "projectKnowledgeSeeded": { "const": false }, "activationEvidenceWritten": { "const": false }, "deploymentActivated": { "const": false }, "productionOrCustomerResourceTouched": { "const": false }
      }
    },
    "failurePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["restoreAttempted", "retryAttempted", "cleanupAttempted", "deletionAttempted"],
      "properties": { "restoreAttempted": { "const": false }, "retryAttempted": { "const": false }, "cleanupAttempted": { "const": false }, "deletionAttempted": { "const": false } }
    },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
