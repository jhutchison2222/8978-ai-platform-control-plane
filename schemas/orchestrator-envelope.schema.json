{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8978.ai/schemas/orchestrator-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId","actionDigest","correlationId","idempotencyKey","workflowName","queueName","projectKnowledgeRef"],
  "properties": {
    "messageId":{"type":"string","minLength":1},"actionDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"correlationId":{"type":"string","minLength":1},"idempotencyKey":{"type":"string","minLength":1},"workflowName":{"type":"string","minLength":1},"queueName":{"type":"string","minLength":1},
    "projectKnowledgeRef":{"type":"object","additionalProperties":false,"required":["recordId","status","version","digest"],"properties":{"recordId":{"type":"string","minLength":1},"status":{"enum":["FINAL","CURRENT"]},"version":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
  }
}
