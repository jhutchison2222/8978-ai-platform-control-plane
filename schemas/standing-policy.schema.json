{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8978.ai/schemas/standing-policy.schema.json",
  "title": "Standing Policy Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policySetId", "policySetVersion", "ownerApprovalThresholds", "policies"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "policySetId": { "type": "string", "minLength": 1 },
    "policySetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ownerApprovalThresholds": { "type": "object", "additionalProperties": false, "required": ["costUsd", "recordCount"], "properties": { "costUsd": { "type": "number", "minimum": 0 }, "recordCount": { "type": "integer", "minimum": 0 } } },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "enabled", "approvedBy", "approvalReference", "validFrom", "validUntil", "environments", "resources", "operations", "maxRisk", "limits", "requiredTests", "reviewer", "rollbackRequired"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "enum": ["active", "superseded", "revoked"] },
          "enabled": { "type": "boolean" },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvalReference": { "type": "string", "minLength": 1 },
          "validFrom": { "type": "string", "format": "date-time" },
          "validUntil": { "type": ["string", "null"], "format": "date-time" },
          "environments": { "type": "array", "minItems": 1, "items": { "enum": ["development", "test", "staging", "production"] } },
          "resources": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string" }, "id": { "type": "string" } } } },
          "operations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "maxRisk": { "enum": ["low", "medium", "high", "critical"] },
          "limits": { "type": "object", "additionalProperties": false, "required": ["costUsd", "recordCount"], "properties": { "costUsd": { "type": "number", "minimum": 0 }, "recordCount": { "type": "integer", "minimum": 0 } } },
          "requiredTests": { "type": "array", "items": { "type": "string" } },
          "reviewer": { "type": "object", "additionalProperties": false, "required": ["required", "independent"], "properties": { "required": { "type": "boolean" }, "independent": { "type": "boolean" } } },
          "rollbackRequired": { "type": "boolean" }
        }
      }
    }
  }
}
