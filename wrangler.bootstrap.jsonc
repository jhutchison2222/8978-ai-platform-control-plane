{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "8978-ai-control-plane-dev",
  "main": "src/control-plane-worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CONTROL_PLANE_MODE": "development",
    "ALLOW_EXTERNAL_WRITES": "false"
  },
  "d1_databases": [
    {
      "binding": "AUTHORITY_DB",
      "database_name": "8978-ai-authority-dev",
      "database_id": "741ade94-8539-4fc8-b6be-24884720dee8",
      "migrations_dir": "migrations/authority"
    }
  ],
  "workflows": [
    {
      "binding": "ORCHESTRATOR_WORKFLOW",
      "name": "8978-ai-orchestrator-dev",
      "class_name": "OrchestratorWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ORCHESTRATOR_QUEUE",
        "queue": "8978-ai-orchestrator-dev"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE_AUTH_REPLAY",
        "class_name": "ServiceAuthReplayDurableObject"
      },
      {
        "name": "IDEMPOTENCY_STORE",
        "class_name": "IdempotencyStateDurableObject"
      },
      {
        "name": "OWNER_DECISION_STORE",
        "class_name": "OwnerDecisionStateDurableObject"
      },
      {
        "name": "AUDIT_STORE",
        "class_name": "AuditStateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ServiceAuthReplayDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["IdempotencyStateDurableObject", "OwnerDecisionStateDurableObject", "AuditStateDurableObject"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
